PORT=3000
NODE_ENV=development

# Twilio WhatsApp Sandbox (yours — developers can get a free sandbox at
# console.twilio.com > Messaging > Try WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to true only once you're ready to verify real Twilio webhook signatures
VALIDATE_TWILIO_SIGNATURE=false

# Hugging Face (your company account) — used for sentiment analysis.
# Model default below works for English; Hinglish/Hindi falls back to the
# keyword list in src/utils/hinglishTemplates.js if the model call fails
# or is low-confidence.
HUGGINGFACE_API_KEY=hf_xxx_your_company_key_here
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# Dashboard basic-auth password (demo only — replace before any real use)
DASHBOARD_PASSWORD=demo123

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Demo business profile (mock — see src/utils/mockData.js)
DEMO_BUSINESS_NAME=Sharma Cafe Pune
DEMO_GOOGLE_REVIEW_URL=https://g.page/sharma-cafe-pune/review
DEMO_FEEDBACK_FORM_URL=https://forms.gle/demo-feedback-form
DEMO_MANAGER_WHATSAPP=+91XXXXXXXXXX
