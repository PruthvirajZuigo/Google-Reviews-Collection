PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/reviewflow
BASE_URL=http://localhost:3000
PRODUCTION_DOMAIN=

# Auth for the dashboard (uses AUTH_SECRET to sign tokens)
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
AUTH_TOKEN_TTL_MS=43200000

# Twilio WhatsApp Sandbox (free at console.twilio.com > Messaging > Try WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Signature validation only when you have a live webhook behind a stable URL
VALIDATE_TWILIO_SIGNATURE=false
TWILIO_TIMEOUT_MS=8000

# Groq API key — used for sentiment + draft + explanation generation.
# If missing, the bot falls back to the keyword lists in
# src/utils/hinglishTemplates.js (works fine for the demo).
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
MAX_AI_CALLS_PER_DAY=50

# Twilio interactive "list-picker" content template SIDs
# (created via the one-off script in _create_templates.js or the Twilio console)
TWILIO_CONTENT_SID_REVIEW_OPTIONS=
TWILIO_CONTENT_SID_FEEDBACK_SAD=
TWILIO_CONTENT_SID_FEEDBACK_NEUTRAL=
TWILIO_CONTENT_SID_REVIEW_THANKS=

# Demo business profile (mock — see src/services/clientConfig.js)
DEFAULT_CLIENT_ID=cli_demo
DEMO_BUSINESS_NAME=Sharma Cafe Pune
DEMO_GOOGLE_REVIEW_URL=https://g.page/sharma-cafe-pune/review
DEMO_FEEDBACK_FORM_URL=https://forms.gle/demo-feedback-form
DEMO_MANAGER_WHATSAPP=+91XXXXXXXXXX
DEMO_BUSINESS_HOURS=9am-9pm, all days
DEMO_BUSINESS_OFFER=10% off on weekday lunches
DEMO_FEATURES_TESTLAB=true

# Tuning (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_LOGIN_MAX=20
REVIEW_CONFIRM_DELAY_MS=1800000
REVIEW_CONFIRM_PROTECTION_DAYS=7
FOLLOWUP_DELAY_MS=86400000
BATCH_CONCURRENCY=5